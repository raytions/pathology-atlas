---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="wrap py-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-5xl">No entry at this address</h1>
    <p class="mt-4 max-w-xl text-ink-2">The page may have moved, or the entry is still under review and not public yet.</p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href={withBase('/')} class="btn">Home</a>
      <a href={withBase('/datasets/')} class="btn">Datasets</a>
      <a href={withBase('/methods/')} class="btn">Methods &amp; Models</a>
    </p>
  </div>
</Base>
