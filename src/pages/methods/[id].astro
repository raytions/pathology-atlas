---
import { withBase } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';
import Cite from '../../components/Cite.astro';
import Sources from '../../components/Sources.astro';
import RelationBadge from '../../components/RelationBadge.astro';
import { relAnchor, USE_ORDER } from '../../lib/relations';
import { loadCatalog, url, type Method } from '../../lib/catalog';
import { INPUT_GRANULARITY, METHOD_CATEGORY, OUTPUT_GRANULARITY, REVIEW_STATUS, WEIGHTS_AVAILABILITY } from '../../lib/vocab';

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.methods.map((m) => ({ params: { id: m.id }, props: { id: m.id } }));
}

const catalog = await loadCatalog();
const m = catalog.method(Astro.props.id) as Method;
const d = m.data;
const paper = d.sources.find((s) => s.key === d.primary_paper);
const relations = [...catalog.relations(m)].sort((a, b) => USE_ORDER.indexOf(a.use) - USE_ORDER.indexOf(b.use));
const evidenceOf = (key: string) => d.sources.find((s) => s.key === key);

// Specific clinical tasks it is applicable to without a recorded result.
const applicable = catalog.tasks.filter(
  (t) => t.data.scope === 'specific' && catalog.methodLinkForTask(m, t.id)?.sameTaskFamily === true,
);
---

<Base title={d.short_name ?? d.title} description={d.summary}>
  <article class="wrap pt-10">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-2">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a href={withBase('/methods/')}>Methods &amp; Models</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{d.short_name ?? d.title}</li>
      </ol>
    </nav>

    <header class="mt-8 grid gap-8 md:grid-cols-[1fr_18rem]">
      <div>
        <p class="eyebrow">{METHOD_CATEGORY[d.category]}{d.year && ` · ${d.year}`}</p>
        <h1 class="mt-2 text-5xl md:text-6xl">{d.short_name ?? d.title}</h1>
        {d.short_name && d.short_name !== d.title && <p class="mt-2 text-ink-3">{d.title}</p>}
        <p class="mt-5 max-w-2xl font-serif text-xl leading-relaxed text-ink-2">{d.summary}</p>
      </div>
      <aside class="self-start border border-rule bg-card p-5 text-sm" aria-label="Official links and status">
        <p class="field-label">Paper</p>
        {paper ? <a href={paper.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-note" class="mt-1 block">{paper.title}</a> : <p class="not-verified">Not verified</p>}
        <p class="field-label mt-4">Code</p>
        {d.code?.url ? <a href={d.code.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-note" class="mt-1 block break-words">{d.code.url.replace(/^https?:\/\//, '')}</a> : <p class="not-verified">Not verified</p>}
        <p class="field-label mt-4">Weights</p>
        {d.weights?.url ? <a href={d.weights.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-note" class="mt-1 block break-words">{d.weights.url.replace(/^https?:\/\//, '')}</a> : <p class={d.weights ? '' : 'not-verified'}>{d.weights ? WEIGHTS_AVAILABILITY[d.weights.availability] : 'Not verified'}</p>}
        <p class="field-label mt-4">Review status</p>
        <p class="mt-1">{REVIEW_STATUS[d.review_status]} · {d.last_verified ? `last verified ${d.last_verified}` : 'not verified'}</p>
      </aside>
    </header>

    <div class="mt-12 grid gap-x-12 gap-y-10 lg:grid-cols-2">
      <section aria-labelledby="glance-h">
        <h2 id="glance-h" class="text-2xl">At a glance</h2>
        <dl class="mt-2 divide-y divide-rule border-y border-rule">
          <Field label="Category" value={METHOD_CATEGORY[d.category]} />
          <Field label="Task family">{d.tasks.map((t, i) => <>{i > 0 && ', '}<a href={url.task(t)}>{catalog.title(t)}</a></>)}</Field>
          <Field label="Input" value={d.input_granularity.map((x) => INPUT_GRANULARITY[x]).join(', ')} />
          <Field label="Output" value={d.output_granularity.map((x) => OUTPUT_GRANULARITY[x]).join(', ')} />
          <Field label="Venue" value={d.venue?.value} source={d.venue?.source} />
        </dl>
      </section>

      <section aria-labelledby="access-h">
        <h2 id="access-h" class="text-2xl">Code &amp; weights</h2>
        <p class="mt-1 text-sm text-ink-3">Code and weights often come with different conditions, so they are listed separately.</p>
        <dl class="mt-2 divide-y divide-rule border-y border-rule">
          <Field label="Code licence" value={d.code ? (d.code.license ?? 'No licence file found') : undefined} source={d.code?.source} />
          <Field label="Code conditions" value={d.code?.conditions} source={d.code?.conditions ? d.code.source : undefined} />
          <Field label="Weights" value={d.weights ? WEIGHTS_AVAILABILITY[d.weights.availability] : undefined} source={d.weights?.source} />
          <Field label="Weights licence" value={d.weights?.license} source={d.weights?.license ? d.weights.source : undefined} />
          <Field label="Weights conditions" value={d.weights?.conditions} source={d.weights?.conditions ? d.weights.source : undefined} />
        </dl>
      </section>
    </div>

    <section aria-labelledby="rel-h" class="rule-t mt-12 pt-6">
      <h2 id="rel-h" class="text-2xl md:text-3xl">Dataset relations</h2>
      <p class="mt-2 max-w-3xl text-sm text-ink-2">
        Each row records how a cited source says the method used a dataset: pretraining, fine-tuning, evaluation or background.
        Nothing beyond the stated use is implied, and no performance numbers are copied here.
      </p>
      {
        relations.length ? (
          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
              <caption class="sr-only">Datasets used by {d.title}, with use and evidence</caption>
              <thead>
                <tr class="border-b border-rule-strong">
                  <th scope="col" class="field-label py-2 pr-4 font-normal">Dataset</th>
                  <th scope="col" class="field-label py-2 pr-4 font-normal">Use</th>
                  <th scope="col" class="field-label py-2 pr-4 font-normal">Task</th>
                  <th scope="col" class="field-label py-2 font-normal">What the source says</th>
                </tr>
              </thead>
              <tbody>
                {relations.map((r) => (
                  <tr id={relAnchor(r)} class="scroll-mt-6 border-b border-rule align-top target:bg-eosin-soft/40" data-use={r.use}>
                    <th scope="row" class="py-3 pr-4 font-normal">
                      <a href={url.dataset(r.dataset)} class="font-serif text-lg">{catalog.title(r.dataset)}</a>
                    </th>
                    <td class="py-3 pr-4"><RelationBadge kind={r.use} /></td>
                    <td class="py-3 pr-4">{r.task ? <a href={url.task(r.task)}>{catalog.title(r.task)}</a> : <span class="not-verified">Not stated</span>}</td>
                    <td class="py-3">
                      {r.note ?? <span class="not-verified">No note</span>}
                      <Cite source={r.evidence} />
                      {evidenceOf(r.evidence) && (
                        <span class="mt-1 block text-xs text-ink-3">
                          Evidence: <a href={`#src-${r.evidence}`}>{evidenceOf(r.evidence)!.title}</a>
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="mt-4 text-ink-2">No relation to a catalogued dataset is recorded for this method.</p>
        )
      }

      {
        applicable.length > 0 && (
          <div class="mt-8">
            <div class="flex flex-wrap items-center gap-3">
              <RelationBadge kind="same-task" size="md" />
              <h3 class="font-sans text-base font-semibold">Same task family, no evaluation recorded</h3>
            </div>
            <p class="mt-1 max-w-3xl text-sm text-ink-3">
              These clinical tasks belong to a family this method targets, but no evaluation or fine-tuning for them is recorded. Not a result.
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {applicable.map((t) => (
                <li>
                  <a href={url.task(t.id)} class="tag hover:border-hema">{t.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <section aria-labelledby="limits-h" class="rule-t mt-12 pt-6">
      <h2 id="limits-h" class="text-2xl md:text-3xl">Known limitations</h2>
      {
        d.limitations.length ? (
          <ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 marker:text-eosin">
            {d.limitations.map((l) => (
              <li>
                {l.value}
                <Cite source={l.source} />
                {l.note && <span class="block text-sm text-ink-2">{l.note}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 not-verified">Not verified</p>
        )
      }
    </section>

    <Sources sources={d.sources} lastVerified={d.last_verified} />
  </article>
</Base>
