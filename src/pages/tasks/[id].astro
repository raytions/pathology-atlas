---
import { withBase } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';
import Sources from '../../components/Sources.astro';
import DatasetCard from '../../components/DatasetCard.astro';
import RelatedMethods from '../../components/RelatedMethods.astro';
import RelationBadge from '../../components/RelationBadge.astro';
import Cite from '../../components/Cite.astro';
import { loadCatalog, url, type Task } from '../../lib/catalog';
import { TASK_SCOPE } from '../../lib/vocab';

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.tasks.map((t) => ({ params: { id: t.id }, props: { id: t.id } }));
}

const catalog = await loadCatalog();
const task = catalog.task(Astro.props.id) as Task;
const d = task.data;
const datasets = catalog.datasetsForTask(task.id);
const methods = catalog.methodsForTask(task.id);
const narrower = catalog.tasks.filter((t) => t.data.broader.includes(task.id));
const organ = d.organs[0];
---

<Base title={d.title} description={d.summary}>
  <article class="wrap pt-10">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-2">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a href={withBase('/organs/')}>Organs</a></li>
        {organ && (<><li aria-hidden="true">/</li><li><a href={url.organ(organ)}>{catalog.title(organ)}</a></li></>)}
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{d.title}</li>
      </ol>
    </nav>

    <header class="mt-8 max-w-3xl">
      <p class="eyebrow">Task · {TASK_SCOPE[d.scope]}</p>
      <h1 class="mt-2 text-5xl md:text-6xl">{d.title}</h1>
      <p class="mt-5 font-serif text-xl leading-relaxed text-ink-2">{d.summary}<Cite source={d.sources[0].key} /></p>
    </header>

    <dl class="mt-8 max-w-3xl divide-y divide-rule border-y border-rule">
      <Field label="Prediction target" value={d.prediction_target} />
      {d.organs.length > 0 && <Field label="Organ">{d.organs.map((o, i) => <>{i > 0 && ', '}<a href={url.organ(o)}>{catalog.title(o)}</a></>)}</Field>}
      {d.diseases.length > 0 && <Field label="Disease">{d.diseases.map((x, i) => <>{i > 0 && ', '}<a href={url.disease(x)}>{catalog.title(x)}</a></>)}</Field>}
      {d.broader.length > 0 && <Field label="Task family">{d.broader.map((b, i) => <>{i > 0 && ', '}<a href={url.task(b)}>{catalog.title(b)}</a></>)}</Field>}
      {narrower.length > 0 && <Field label="Clinical tasks">{narrower.map((b, i) => <>{i > 0 && ', '}<a href={url.task(b.id)}>{b.data.title}</a></>)}</Field>}
    </dl>

    <section aria-labelledby="ds-h" class="rule-t mt-12 pt-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="ds-h" class="text-2xl md:text-3xl">Datasets</h2>
        {datasets.length > 0 && <a href={withBase(`/datasets/?task=${task.id}`)} class="text-sm">Open as a filtered list →</a>}
      </div>
      {
        datasets.length ? (
          <ul class="mt-5 grid gap-4 md:grid-cols-2">
            {datasets.map((x) => <DatasetCard dataset={x} catalog={catalog} />)}
          </ul>
        ) : (
          <p class="mt-3 text-ink-2">
            {d.scope === 'general' ? 'This is a task family. Datasets are listed on its clinical tasks above.' : 'No verified dataset yet.'}
          </p>
        )
      }
    </section>

    <RelatedMethods groups={methods} catalog={catalog} contextTitle={d.title} />
    <p class="mt-4 text-sm"><a href={withBase(`/methods/?task=${task.id}`)}>Open methods filtered by this task →</a></p>

    {
      d.background_reading.length > 0 && (
        <section aria-labelledby="bg-h" class="rule-t mt-12 pt-6">
          <div class="flex flex-wrap items-center gap-3">
            <RelationBadge kind="background" size="md" />
            <h2 id="bg-h" class="text-2xl">Background reading</h2>
          </div>
          <ul class="mt-4 space-y-4">
            {d.background_reading.map((r) => (
              <li class="max-w-3xl border-l-2 border-rule pl-4">
                <a href={r.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-note" class="font-serif text-lg">{r.title}</a>
                <p class="text-sm text-ink-2">{r.why}<Cite source={r.source} /></p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Sources sources={d.sources} lastVerified={d.last_verified} />
  </article>
</Base>
