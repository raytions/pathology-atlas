---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import TissueMark from '../components/TissueMark.astro';
import RelationBadge from '../components/RelationBadge.astro';
import RelationLegend from '../components/RelationLegend.astro';
import { loadCatalog, url, scaleParts } from '../lib/catalog';
import { relAnchor } from '../lib/relations';
import { FEATURED_PATH } from '../data/featured';
import { ACCESS_METHOD, DATA_UNITS, RELATION_KIND } from '../lib/vocab';

const catalog = await loadCatalog();
// Explicit organ / task / dataset; throws (and fails the build) if not published and linked.
const path = catalog.featuredPath(FEATURED_PATH);
const { organ, task, dataset, methods } = path;
const dsScale = scaleParts(dataset);

const entries = [
  {
    href: withBase('/organs/'),
    n: '01',
    title: 'Organs & Diseases',
    body: 'Start from anatomy. Topic pages pull together diseases, tasks, datasets and methods.',
    count: `${catalog.organs.length} organs · ${catalog.tasks.filter((t) => t.data.scope === 'specific').length} clinical tasks`,
  },
  {
    href: withBase('/datasets/'),
    n: '02',
    title: 'Datasets',
    body: 'Scale by unit, annotation granularity, splits, access route and terms, each with its source.',
    count: `${catalog.datasets.length} verified datasets`,
  },
  {
    href: withBase('/methods/'),
    n: '03',
    title: 'Methods & Models',
    body: 'Code and weight access listed separately; dataset links labelled by how they were used.',
    count: `${catalog.methods.length} verified methods`,
  },
];
---

<Base title="Pathology Atlas">
  <section class="wrap pt-14 pb-12 md:pt-20">
    <p class="eyebrow">Computational pathology · resource atlas</p>
    <h1 class="mt-4 max-w-3xl text-5xl leading-[1.05] md:text-7xl">Find data, methods and papers by organ, disease and task.</h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-2">
      A small, source-checked catalogue. Every number points to where it came from, and every link between a method and a
      dataset says what kind of link it is.
    </p>
    <ul class="mt-10 grid grid-cols-3 gap-3 md:gap-6" aria-label="Organ topics">
      {
        catalog.organs.map((o) => (
          <li>
            <a href={url.organ(o.id)} class="group block no-underline">
              <TissueMark organ={o.id} class="w-full transition-opacity group-hover:opacity-80" />
              <span class="mt-2 block font-serif text-lg text-ink group-hover:text-hema md:text-2xl">{o.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="entry-h" class="wrap">
    <h2 id="entry-h" class="sr-only">Browse</h2>
    <ul class="grid border-t border-rule md:grid-cols-3">
      {
        entries.map((e) => (
          <li class="relative border-b border-rule py-7 md:border-b-0 md:border-r md:px-6 md:first:pl-0 md:last:border-r-0">
            <span class="font-mono text-xs text-eosin">{e.n}</span>
            <h3 class="mt-2 text-3xl">
              <a href={e.href} class="text-ink no-underline after:absolute after:inset-0 hover:text-hema">
                {e.title}
              </a>
            </h3>
            <p class="mt-2 text-ink-2">{e.body}</p>
            <p class="mt-4 font-mono text-xs text-ink-3">{e.count}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="feat-h" class="wrap mt-16" data-featured-path data-organ={organ.id} data-task={task.id} data-dataset={dataset.id}>
    <div class="border border-rule bg-card">
      <div class="grid gap-8 p-6 md:grid-cols-[1fr_1.2fr] md:p-10">
        <div>
          <p class="eyebrow">Featured topic</p>
          <h2 id="feat-h" class="mt-2 text-4xl md:text-5xl">
            <a href={url.organ(organ.id)} class="text-ink">{organ.data.title}</a>
          </h2>
          <p class="mt-4 text-ink-2">{organ.data.summary}</p>
          <a href={url.organ(organ.id)} class="btn mt-6">Open the {organ.data.title.toLowerCase()} topic</a>
        </div>

        <div>
          <p class="field-label">A worked path</p>
          <ol class="mt-3 border-l border-rule-strong">
            <li class="relative pb-5 pl-6">
              <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-ink" aria-hidden="true"></span>
              <span class="eyebrow">Organ</span>
              <a href={url.organ(organ.id)} class="block font-serif text-xl">{organ.data.title}</a>
            </li>
            <li class="relative pb-5 pl-6">
              <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-eosin" aria-hidden="true"></span>
              <span class="eyebrow">Task</span>
              <a href={url.task(task.id)} class="block font-serif text-xl">{task.data.title}</a>
              {task.data.prediction_target && <span class="text-sm text-ink-2">{task.data.prediction_target}</span>}
            </li>
            <li class="relative pb-5 pl-6">
              <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-hema" aria-hidden="true"></span>
              <span class="eyebrow">Dataset</span>
              <a href={url.dataset(dataset.id)} class="block font-serif text-xl">{dataset.data.title}</a>
              <dl class="mt-1 grid gap-x-4 gap-y-0.5 text-sm text-ink-2 sm:grid-cols-[auto_1fr]">
                <dt class="field-label pt-0.5">Scale</dt>
                <dd>{dsScale.length ? dsScale.join(' · ') : <span class="not-verified">Not verified</span>}</dd>
                <dt class="field-label pt-0.5">Data unit</dt>
                <dd>{dataset.data.data_units.map((u) => DATA_UNITS[u]).join(', ')}</dd>
                <dt class="field-label pt-0.5">Access</dt>
                <dd>{dataset.data.access ? ACCESS_METHOD[dataset.data.access.method] : <span class="not-verified">Not verified</span>}</dd>
              </dl>
            </li>
            <li class="relative pl-6">
              <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full border border-hema bg-card" aria-hidden="true"></span>
              <span class="eyebrow">Methods on {dataset.data.title} for {task.data.title}</span>
              {
                !methods.hasEvaluation && (
                  <p class="mt-1 text-sm not-verified" data-no-evaluation>
                    No evaluation on {dataset.data.title} for {task.data.title} is recorded in the atlas yet.
                  </p>
                )
              }
              {
                methods.direct.length > 0 && (
                  <ul class="mt-1 space-y-1.5" aria-label={`Recorded relations to ${dataset.data.title}`}>
                    {methods.direct.map(({ method, link }) => (
                      <li class="flex flex-wrap items-center gap-2" data-method={method.id} data-uses={link.uses.join(' ')}>
                        <a href={url.method(method.id)} class="font-serif text-lg">{method.data.short_name ?? method.data.title}</a>
                        {link.relations.map((r) => (
                          <a href={`${url.method(method.id)}#${relAnchor(r)}`} class="no-underline" aria-label={`${RELATION_KIND[r.use].label} ${dataset.data.title}: relation record`}>
                            <RelationBadge kind={r.use} />
                          </a>
                        ))}
                      </li>
                    ))}
                  </ul>
                )
              }
              {
                methods.familyOnly.length > 0 && (
                  <>
                    <p class="mt-3 text-xs text-ink-3">Same task family, no recorded relation to {dataset.data.title}:</p>
                    <ul class="mt-1 space-y-1.5">
                      {methods.familyOnly.map(({ method }) => (
                        <li class="flex flex-wrap items-center gap-2" data-method={method.id} data-uses="">
                          <a href={url.method(method.id)} class="font-serif text-lg">{method.data.short_name ?? method.data.title}</a>
                          <RelationBadge kind="same-task" />
                        </li>
                      ))}
                    </ul>
                  </>
                )
              }
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap mt-16" aria-labelledby="legend-h">
    <h2 id="legend-h" class="eyebrow">How to read relation labels</h2>
    <div class="mt-4 border-t border-rule pt-5">
      <RelationLegend />
    </div>
  </section>
</Base>
