---
import type { Catalog, Dataset } from '../lib/catalog';
import { url, fmt } from '../lib/catalog';
import { ACCESS_METHOD, ANNOTATION_GRANULARITY, DATA_UNITS } from '../lib/vocab';

interface Props {
  dataset: Dataset;
  catalog: Catalog;
  headingLevel?: 'h2' | 'h3';
  attrs?: Record<string, string>;
}
const { dataset: ds, catalog, headingLevel = 'h3', attrs = {} } = Astro.props;
const d = ds.data;
const H = headingLevel;
// Slides are only downloadable when the release ships WSIs. For patch-only releases the slide
// count describes where the patches were cut from, so it is shown as "from N source slides".
const shipsSlides = d.data_units.includes('wsi');
const slides = d.scale.slides && fmt(d.scale.slides.value);
const patches = d.scale.patches && fmt(d.scale.patches.value);
const scale = [
  shipsSlides && slides && `${slides} slides`,
  patches && (!shipsSlides && slides ? `${patches} patches from ${slides} source slides` : `${patches} patches`),
  !patches && !shipsSlides && slides && `${slides} source slides`,
  d.scale.patients && `${fmt(d.scale.patients.value)} patients`,
  d.scale.rois && `${fmt(d.scale.rois.value)} ROIs`,
].filter(Boolean);
---

<li class="group relative flex flex-col border border-rule bg-card p-5 transition-colors focus-within:border-hema hover:border-rule-strong" {...attrs}>
  <div class="flex items-start justify-between gap-3">
    <H class="text-2xl leading-tight">
      <a href={url.dataset(ds.id)} class="text-ink no-underline after:absolute after:inset-0 hover:text-hema focus-visible:outline-none">
        {d.title}
      </a>
    </H>
    <span class="eyebrow mt-1 shrink-0">Dataset</span>
  </div>
  <p class="mt-2 line-clamp-3 text-[0.93rem] text-ink-2">{d.summary}</p>

  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
    <div>
      <dt class="field-label">Organ</dt>
      <dd>{d.organs.map((o) => catalog.title(o)).join(', ')}</dd>
    </div>
    <div>
      <dt class="field-label">Task</dt>
      <dd>{d.tasks.map((t) => catalog.title(t)).join(', ')}</dd>
    </div>
    <div>
      <dt class="field-label">Annotation</dt>
      <dd>{d.annotation_granularity.map((a) => ANNOTATION_GRANULARITY[a]).join(', ')}</dd>
    </div>
    <div>
      <dt class="field-label">Access</dt>
      <dd>{d.access ? ACCESS_METHOD[d.access.method] : <span class="not-verified">Not verified</span>}</dd>
    </div>
  </dl>

  <p class="mt-auto flex flex-wrap gap-1.5 pt-4 text-xs">
    <span class="tag">{d.data_units.map((u) => DATA_UNITS[u]).join(' + ')}</span>
    {scale.length ? <span class="tag">{scale.join(' · ')}</span> : <span class="tag not-verified">Scale not verified</span>}
    {d.terms && <span class="tag">{d.terms.license.replace(/\s*\(.*\)$/, '')}</span>}
  </p>
</li>
