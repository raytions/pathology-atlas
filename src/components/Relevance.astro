---
import { RELEVANCE } from '../lib/vocab';
import type { Relevance as R } from '../lib/catalog';

interface Props {
  kind: R;
  size?: 'sm' | 'md';
}
const { kind, size = 'sm' } = Astro.props;
const styles: Record<R, string> = {
  benchmark: 'border-hema bg-hema-soft text-hema',
  'same-task': 'border-rule-strong bg-card text-ink-2 border-dashed',
  background: 'border-rule bg-paper-2 text-ink-3',
};
---

<span
  class:list={['inline-flex items-center gap-1.5 rounded-full border px-2 font-mono uppercase tracking-wide', styles[kind], size === 'sm' ? 'py-0 text-[0.66rem]' : 'py-0.5 text-xs']}
  title={RELEVANCE[kind].help}
>
  <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true" class="shrink-0">
    {kind === 'benchmark' && <circle cx="4" cy="4" r="3.5" fill="currentColor" />}
    {kind === 'same-task' && (<><circle cx="4" cy="4" r="3.25" fill="none" stroke="currentColor" /><path d="M4 0.75a3.25 3.25 0 0 1 0 6.5z" fill="currentColor" /></>)}
    {kind === 'background' && <circle cx="4" cy="4" r="3.25" fill="none" stroke="currentColor" />}
  </svg>{RELEVANCE[kind].short}
</span>
