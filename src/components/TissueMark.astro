---
/**
 * Original abstract illustration (no patient tissue). "glands" suggests glandular
 * lumens ringed by nuclei; "crypts" suggests colonic crypts cut lengthwise; "node"
 * suggests a lymph node with scattered deposits. Pass `organ` to pick the organ's variant.
 * Deterministic pseudo-random layout so builds are reproducible.
 */
type Variant = 'glands' | 'crypts' | 'node' | 'field';
interface Props {
  variant?: Variant;
  organ?: string;
  class?: string;
}
// Breast maps to a lymph node because its catalogued tasks are nodal metastasis detection.
const ORGAN_VARIANT: Record<string, Variant> = { prostate: 'glands', colorectum: 'crypts', breast: 'node' };
const { organ, class: cls } = Astro.props;
const variant: Variant = (organ ? ORGAN_VARIANT[organ] : undefined) ?? Astro.props.variant ?? 'field';

let seed = variant === 'glands' ? 7 : variant === 'node' ? 19 : variant === 'crypts' ? 11 : 3;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

type Gland = { cx: number; cy: number; r: number; ry?: number };
const glands: Gland[] =
  variant === 'glands'
    ? [
        { cx: 70, cy: 72, r: 30 },
        { cx: 150, cy: 60, r: 22 },
        { cx: 128, cy: 140, r: 34 },
        { cx: 56, cy: 160, r: 20 },
        { cx: 196, cy: 128, r: 16 },
      ]
    : variant === 'crypts'
      ? [40, 82, 124, 166, 206].map((cx, i) => ({ cx, cy: 104 + (i % 2) * 8, r: 12, ry: 58 }))
      : variant === 'node'
        ? [{ cx: 120, cy: 112, r: 86 }]
      : [
          { cx: 80, cy: 90, r: 26 },
          { cx: 160, cy: 130, r: 30 },
        ];

const nuclei: { x: number; y: number; r: number; tone: 'h' | 'e' }[] = [];
for (const g of glands) {
  const n = Math.round((g.r + (g.ry ?? g.r)) / 2 * (variant === 'node' ? 0.5 : variant === 'crypts' ? 1.3 : 0.9));
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2 + rand() * 0.2;
    const rr = 5 + rand() * 3;
    nuclei.push({ x: g.cx + Math.cos(a) * (g.r + rr), y: g.cy + Math.sin(a) * ((g.ry ?? g.r) + rr), r: 2 + rand() * 1.4, tone: 'h' });
  }
}
// stromal scatter
for (let i = 0; i < (variant === 'node' ? 120 : 46); i++) {
  const x = 10 + rand() * 220;
  const y = 10 + rand() * 178;
  if (variant !== 'node' && glands.some((g) => Math.hypot((x - g.cx) / (g.r + 10), (y - g.cy) / ((g.ry ?? g.r) + 10)) < 1)) continue;
  if (variant === 'node' && Math.hypot(x - 120, y - 112) > 84) continue;
  nuclei.push({ x, y, r: 1 + rand() * 1.6, tone: rand() > 0.82 ? 'e' : 'h' });
}
const deposits = variant === 'node' ? [{ x: 150, y: 86, r: 16 }, { x: 92, y: 140, r: 7 }] : [];
---

<svg viewBox="0 0 240 220" class={cls} role="img" aria-label="Abstract illustration, not a tissue image">
  <rect x="0.5" y="0.5" width="239" height="219" fill="var(--color-card)" stroke="var(--color-rule)" />
  {variant !== 'node' && <rect x="0.5" y="0.5" width="239" height="219" fill="var(--color-eosin-soft)" opacity="0.35" />}
  {
    glands.map((g) => (
      <ellipse cx={g.cx} cy={g.cy} rx={g.r} ry={g.ry ?? g.r} fill={variant === 'node' ? 'var(--color-hema-soft)' : 'var(--color-card)'} stroke="var(--color-eosin)" stroke-width="0.8" opacity="0.9" />
    ))
  }
  {deposits.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill="var(--color-eosin-soft)" stroke="var(--color-eosin)" stroke-width="0.8" stroke-dasharray="2 2" />)}
  {nuclei.map((n) => <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={n.r.toFixed(2)} fill={n.tone === 'h' ? 'var(--color-hema)' : 'var(--color-eosin)'} opacity="0.78" />)}
  <line x1="16" y1="204" x2="56" y2="204" stroke="var(--color-ink)" stroke-width="1" />
  <text x="60" y="207" font-family="var(--font-mono)" font-size="7" fill="var(--color-ink-3)">schematic, not to scale</text>
</svg>
